# SpamGuard Backend Environment Configuration
# Copy this file to .env and fill in your private API keys.
# NEVER commit the actual .env file with secrets to Git.

# Google Gemini API Key for AI Security Analysis, Explanations, and Copilot
GEMINI_API_KEY=your_gemini_api_key_here

# VirusTotal API Key for URL Reputation and Threat Intelligence Lookups
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Server Host & Port
HOST=127.0.0.1
PORT=8008
